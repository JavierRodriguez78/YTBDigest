# ---- Fuentes ----
# En Docker estas dos las fija el compose a /app/data/...
SUBSCRIPTIONS_FILE=./data/subscriptions.csv
STATE_FILE=./data/state.json
LOOKBACK_HOURS=26

# ---- Idioma ----
SPANISH_ONLY=true
# true = los vídeos de tus canales pasan aunque publiquen en inglés
KEEP_ALL_SUBSCRIPTIONS=false

# ---- Intereses ----
# Cada tema de INTERESTS = 1 búsqueda/día = 100 unidades de cuota (tope 10.000/día).
# 14 temas = 1.400 unidades. Añade los que quieras sin miedo, pero temas muy genéricos
# ("tecnologia") devuelven ruido: mejor específicos.
INTERESTS=inteligencia artificial,agentes IA LLM,homelab casero,proxmox,self-hosting docker,montar rack servidores casa,redes domesticas vlan pfsense,NAS almacenamiento casero,reparacion de consolas,reparacion de moviles,reparacion electronica soldadura,microsoldadura placa base,restauracion consolas retro,electronica diy
BOOST_KEYWORDS=ia,ai,llm,agente,agentes,mcp,claude,rag,nestjs,typescript,nodejs,arquitectura,devops,kubernetes,terraform,homelab,proxmox,docker,self-hosted,selfhosted,nas,rack,servidor,vlan,pfsense,opnsense,truenas,unraid,zfs,ups,switch,poe,reparacion,reparar,averia,soldadura,microsoldadura,multimetro,osciloscopio,placa base,condensador,recap,retro,consola,mando,pantalla,bateria,flex,psu,fuente de alimentacion
BLOCK_KEYWORDS=shorts,sorteo

MAX_SUBSCRIPTION_ITEMS=25
MAX_DISCOVERY_ITEMS=14
DISCOVERY_PER_INTEREST=8

# ---- YouTube Data API v3 (solo para la parte de descubrimiento) ----
# console.cloud.google.com -> habilitar "YouTube Data API v3" -> credencial API key
YOUTUBE_API_KEY=

# ---- Valoración opcional con Claude ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- Entrega ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Programación ----
# El compose fija DAILY_AT=08:00 en el servicio "digest" y lo vacía en "once".
# Aquí solo hace falta si lo lanzas fuera de Docker.
DAILY_AT=
RUN_ON_START=true
TZ=Europe/Madrid

# Imprime pero no envía ni marca como visto
DRY_RUN=false
