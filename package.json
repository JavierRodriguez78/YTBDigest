{
  "name": "yt-digest",
  "version": "1.0.0",
  "private": true,
  "description": "Digest diario de vídeos de YouTube: novedades de tus suscripciones + descubrimiento por temas",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "once": "DAILY_AT= node --env-file-if-exists=.env dist/index.js",
    "dry-run": "DAILY_AT= DRY_RUN=true node --env-file-if-exists=.env dist/index.js",
    "check-subs": "node --env-file-if-exists=.env dist/scripts/check-subs.js",
    "resolve-handles": "node --env-file-if-exists=.env dist/scripts/resolve-handles.js"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
